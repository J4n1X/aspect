# expected: 3
# compile_args: "-I", "lib"
#-
  A `meta` global carries state across transform firings. The handler counts its
  own invocations and rewrites the first coercion site to `.first()` and every
  later one to `.second()`. Two `Str -> u8*` sites fire, so one becomes `"x"`
  (len 1) and the other `"yy"` (len 2): the sum is 3 regardless of which site
  fires first (firing order is unspecified, but each method fires exactly once).
  If the counter didn't persist across firings, both would take the same branch
  and the sum would be 2 or 4.
-#
type Str {
    public u8* a
    public u8* b
    public fn first(this) -> u8* { return this.a }
    public fn second(this) -> u8* { return this.b }
}

meta u32 fired = 0

transform fn pick(Expr site) -> Expr {
    fired = fired + 1
    if fired == 1 as u32 {
        return Ast.method(site, "first")
    }
    return Ast.method(site, "second")
}
transform Str -> u8* pick

extern fn strlen(u8* s) -> u64

fn main(u32 argc, u8 **argv) -> i32 {
    Str s = Str { a = "x", b = "yy" }
    return (strlen(s) + strlen(s)) as i32
}
