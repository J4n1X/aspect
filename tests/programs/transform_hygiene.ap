# expected: 5
# compile_args: "-I", "lib"
#-
  Hygiene (`doc/plans/Quote-Plan.md` §3), proven against the actual bug it
  fixes: capture, not cross-firing collision. The handler's quote declares a
  local named `__v` — `quote { u8* __v = $(site).c_str() return __v }` — and
  the demand site itself is a variable *also* named `__v`. Without renaming
  the binder, the constructed value-block once spliced in is
  `{ u8* __v = __v.c_str() return __v }`: the inner `__v`'s own declaration
  is visible (unbound) while its initializer is checked, so `__v.c_str()`
  captures the inner (not-yet-initialized) `__v` — whose type is `u8*`, which
  has no `.c_str()` method, so this fails to compile at all without the
  rename (verified directly: reverting the rename in `desugar_quotes`
  reproduces exactly this "Method receiver must be a type-struct" error).
  With the rename in place, `__v.c_str()` correctly resolves to the *outer*
  `__v` (the `Str` demand site), and the program runs: strlen("hello") = 5.
-#
type Str {
    public u8* ptr
    public fn c_str(this) -> u8* { return this.ptr }
}

transform fn to_cstr(Expr site) -> Expr {
    return quote { u8* __v = $(site).c_str() return __v }
}
transform Str -> u8* to_cstr

extern fn strlen(u8* s) -> u64

fn main(u32 argc, u8 **argv) -> i32 {
    Str __v = Str { ptr = "hello" }
    return strlen(__v) as i32
}
