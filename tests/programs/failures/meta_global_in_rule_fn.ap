# expected: "meta global", "transform fn"
# compile_args: "-I", "lib"
#-
  In v1 a `meta` global lives only in the persistent transform engine, so a
  `rule fn` (a separate, per-invocation judge) cannot see its live value. Reading
  one from a rule is a meta-scope error until cross-hook access lands.
-#
meta u32 fired = 0

rule fn chk(Program p, Type anchor) -> Judgments {
    Judgments js = Judgments.new()
    u32 seen = fired
    return js
}
rule Widget chk

type Widget { public i32 x }

fn main(u32 argc, u8 **argv) -> i32 {
    return 0
}
