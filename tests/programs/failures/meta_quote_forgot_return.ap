# expected: "type mismatch"
# compile_args: "-I", "lib"
#-
  A quote's body is always a statement sequence; `return` is what makes it
  value-producing (`doc/plans/Quote-Plan.md` §1). A body ending in a bare
  expression-statement — exactly the pre-migration bare-quote shape, minus
  `return` — is a legal *void* quote (lowers to `Ast.block`, a `Stmt`), not a
  parse error — but a `transform fn (Expr) -> Expr` handler wants an `Expr`
  back, so this is an ordinary `Stmt`-vs-`Expr` type mismatch at the `return`,
  not a bespoke "you forgot `return`" diagnostic. No `UnsupportedQuoteShape`
  here: the construct is fully supported, just used in the wrong position.
-#
type Str {
    public u8* ptr
    public fn c_str(this) -> u8* { return this.ptr }
}

transform fn to_cstr(Expr site) -> Expr { return quote { $(site).c_str() } }
transform Str -> u8* to_cstr

extern fn strlen(u8* s) -> u64

fn main(u32 argc, u8 **argv) -> i32 {
    Str s = Str { ptr = "hello" }
    return strlen(s) as i32
}
