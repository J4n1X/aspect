# expected: "dead", "already coerces"
# compile_args: "-I", "lib"
#-
  A coercion key that built-in coercion already satisfies (`i32` widens to `i64`)
  is dead — the handler could never fire — and is rejected before elaboration.
-#
transform fn widen(Expr site) -> Expr { return site }
transform i32 -> i64 widen

fn main(u32 argc, u8 **argv) -> i32 {
    return 0
}
