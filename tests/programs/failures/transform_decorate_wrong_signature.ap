# expected: "must be a", "(Stmt) -> Stmt"
# compile_args: "-I", "lib"
#-
  An attribute-key transform whose handler is an `(Expr) -> Expr` (a coercion
  handler), not a decoration `(Stmt) -> Stmt`, is rejected before elaboration.
  Attribute keys decorate statements, so the handler must take and return a Stmt.
-#
type Str { public u8* ptr }

transform fn coercer(Expr site) -> Expr { return Ast.method(site, "ptr") }
transform @log coercer

fn main(u32 argc, u8 **argv) -> i32 {
    return 0
}
