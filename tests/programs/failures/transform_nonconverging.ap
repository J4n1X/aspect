# expected: "did not settle", "keeps rewriting"
# compile_args: "-I", "lib"
#-
  A handler that returns the demand site unchanged never discharges the
  obligation: every round re-fires it, so elaboration never reaches a fixpoint.
  The round cap catches the runaway instead of looping forever.
-#
type Str {
    public u8* ptr
}

transform fn loop_it(Expr site) -> Expr { return site }
transform Str -> u8* loop_it

extern fn strlen(u8* s) -> u64

fn main(u32 argc, u8 **argv) -> i32 {
    Str s = Str { ptr = "hi" }
    return strlen(s) as i32
}
