# expected: "type mismatch", "u8*"
# compile_args: "-I", "lib"
#-
  A `transform fn` handler exists, but nothing binds it to the `Str -> u8*`
  coercion. With no handler registered for the key, the stuck demand site has
  nothing to consult and stays an ordinary type error — the opt-in is the binding,
  not the mere presence of a handler.
-#
type Str {
    public u8* ptr
    public fn c_str(this) -> u8* { return this.ptr }
}

transform fn to_cstr(Expr site) -> Expr { return Ast.method(site, "c_str") }

extern fn strlen(u8* s) -> u64

fn main(u32 argc, u8 **argv) -> i32 {
    Str s = Str { ptr = "hi" }
    return strlen(s) as i32
}
