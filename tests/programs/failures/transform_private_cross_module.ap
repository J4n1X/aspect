# expected: "type mismatch", "u8*"
# compile_args: "-I", "lib", "-I", "tests/modules"
#-
  A private `transform` governs only its declaring module. `coerce_priv`'s
  `PStr -> u8*` handler does not reach the root module, so the root's `strlen(s)`
  demand site is not repaired and stays an ordinary type error — the
  transform-visibility analogue of a module-scoped rule.
-#
$import coerce_priv

extern fn strlen(u8* s) -> u64

fn main(u32 argc, u8 **argv) -> i32 {
    PStr s = PStr { ptr = "hi" }
    return strlen(s) as i32
}
