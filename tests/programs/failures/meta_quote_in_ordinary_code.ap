# expected: "quote", "meta function"
#-
  `quote { ... }` is an AST-construction template — legal only inside a meta
  function (`rule fn` / `transform fn`). It needs no `transform`/`rule`
  declaration anywhere in the file to parse (recognition is purely syntactic),
  so the meta-scope gate must catch this even when the file has no other
  meta surface in play at all.
-#
fn bad() -> i32 {
    quote { 1 }
    return 0
}

fn main(u32 argc, u8 **argv) -> i32 {
    return 0
}
