# expected: "not an expression", "`||` cannot guarantee the binding matched"
# `s is S.A(v) && x || y` parses with `||` at the root — the `is` sits beside
# an `&&` but is not a top-level conjunct, so the binding is illegal.

sum S {
    A(i32 x)
    B
}

fn main(u32 argc, u8 **argv) -> i32 {
    S s = S.B
    bool y = true
    if s is S.A(v) && v > 0 || y {
        return 1
    }
    return 0
}
