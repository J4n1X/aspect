# expected: "already has a handler", "one key, one handler"
# compile_args: "-I", "lib"
#-
  Two handlers bound to the same coercion key with overlapping reach is
  ambiguous. Rather than silently letting the first win, the later binding is
  rejected before elaboration.
-#
type Str {
    public u8* ptr
    public fn c_str(this) -> u8* { return this.ptr }
}

transform fn h1(Expr site) -> Expr { return Ast.method(site, "c_str") }
transform fn h2(Expr site) -> Expr { return Ast.method(site, "c_str") }
transform Str -> u8* h1
transform Str -> u8* h2

fn main(u32 argc, u8 **argv) -> i32 {
    return 0
}
