# expected: 56
# Test break and continue; also the paren-less `for` header's optional
# clauses (empty increment, and the all-empty `for ;; {` idiom + break).
fn main(u32 argc, u8 **argv) -> i32 {
    i32 total = 0

    # Test break: sum 1..5, break at 4
    for i32 i = 1; i <= 10; i = i + 1 {
        if i == 5 {
            break
        }
        total = total + i
    }
    # total = 1+2+3+4 = 10

    # Test continue: skip even numbers
    for i32 j = 1; j <= 5; j = j + 1 {
        if j % 2 == 0 {
            continue
        }
        total = total + j
    }
    # total = 10 + 1 + 3 + 5 = 19

    # Test break in while loop
    i32 k = 0
    while k < 100 {
        k = k + 1
        if k == 3 {
            break
        }
    }
    # k = 3, total = 19 + 3 = 22
    total = total + k

    # Regression: `continue` inside a `for` loop must jump to the increment
    # step, not directly back to the condition. If it skipped the increment,
    # the first `continue` would freeze the loop variable at its current
    # value and the program would never terminate. Sums odd values 1..=10:
    # 1 + 3 + 5 + 7 + 9 = 25.
    i32 forSum = 0
    for i32 m = 1; m <= 10; m = m + 1 {
        if m % 2 == 0 { continue }
        forSum = forSum + m
    }
    total = total + forSum
    # total = 22 + 25 = 47

    # Empty increment clause: the step lives in the body.
    for i32 n = 0; n < 3; {
        total = total + 2
        n += 1
    }
    # total = 47 + 6 = 53

    # All three clauses empty — the `for ;; {` infinite-loop idiom.
    for ;; {
        total = total + 3
        break
    }

    return total  # 53 + 3 = 56
}
