# expected: 165
fn main(u32 argc, u8 **argv) -> i32 {
    # Plain `ptr + int`.
    i32 *ptr = 123 as i32*
    i32 offset = 20
    ptr = ptr + offset
    i32 s1 = (ptr - offset) as i32              # 123

    # Commuted `int + ptr` — regression: only the left operand used to be
    # checked for pointer-ness, so `1 + arr` panicked in codegen.
    i64[3] arr = {10, 20, 30}
    i64* p = 1 + arr
    i64 a = *p
    i64 b = *(1 + p)
    i64 c = *(p - 1)
    i32 s2 = (a + b + c - 18) as i32            # 42

    return s1 + s2                              # 123 + 42 = 165
}
