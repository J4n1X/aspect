# expected: 0
# compile_args: "-I", "lib"
#-
  Void quotes (`doc/plans/Quote-Plan.md` §1/§4): a body not ending in
  `return <expr>` lowers to `Ast.block` (`StatementKind::Block`, a `Stmt`),
  not `Ast.value_block` (`ExprKind::ValueBlock`, unconditionally
  value-producing — verified against the checker while designing this, no
  void form exists). Nothing consumes a `Stmt` splice yet (that's decoration,
  hook #2b, not built), so this is proven independently: a `rule fn`
  constructs `quote { $(e) }` (one expression-statement, no `return` — void)
  and inspects the result through the read-side query API, asserting the
  *actual* `StmtKind` rather than just that construction didn't crash — a
  wrongly-built `ExprKind::ValueBlock` under a mismatched handle kind would
  not be caught by weaker assertions (both expose the same
  count-of-children shape). An error here fails the whole build (`rule`s
  run automatically, post-typecheck, over the whole program), so `main`
  returning cleanly is itself the proof.
-#
rule fn chk(Program p, Type anchor) -> Judgments {
    Judgments js = Judgments.new()
    Expr e = Ast.var("x")
    Stmt s = quote { $(e) }
    if s.kind() != StmtKind.Block {
        js.error(s.pos(), "void quote did not build a Block statement")
    }
    return js
}
rule Widget chk

type Widget { public i32 x }

fn main(u32 argc, u8 **argv) -> i32 {
    return 0
}
