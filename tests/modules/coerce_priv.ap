# Module fixture: a private coercion transform. Loaded only via $import (no
# `# expected:` line). A private `transform` governs only its declaring module,
# so a demand site in an importing module is NOT repaired by this handler.
$module coerce_priv

public type PStr {
    public u8* ptr
    public fn c_str(this) -> u8* { return this.ptr }
}

transform fn cstr_priv(Expr site) -> Expr { return Ast.method(site, "c_str") }
transform PStr -> u8* cstr_priv
