# Module fixture: a public decoration transform. Loaded only via $import (no
# `# expected:` line). A `public transform @log` reaches the whole program, so an
# `@log`-tagged binding in an importing module fires this handler.
$module log_pub

public i64 log_total = 0

public type Amount {
    public i64 v
    public fn logged(this) -> Amount { log_total = log_total + this.v; return Amount { v = this.v } }
}

transform fn log_it(Stmt node) -> Stmt {
    Expr a = node.value_expr()
    return node.with_value_expr(quote { return $(a).logged() })
}
public transform @log log_it
